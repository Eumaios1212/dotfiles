#!/usr/bin/env bash
# Recreate the 550 desktop terminal layout. The watch-only Agent VM session is a
# pane beside Agent-Issue; hbot gets its own kitty tab (not nested tmux, so its
# key bindings work). Both remote views wait for Enter.
set -euo pipefail

detached=false
case "${1:-}" in
    '') ;;
    --detached) detached=true; shift ;;
    -h|--help)
        printf 'Usage: 550-session [--detached]\nCreate or attach to the 550 workspace. The Agent VM pane and hbot kitty tab wait for Enter.\n'
        exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
esac
if (( $# )); then
    printf 'Usage: 550-session [--detached]\n' >&2
    exit 2
fi
if [[ $(hostname -s) != 550 ]]; then
    printf 'This workspace launcher is for host 550 only.\n' >&2
    exit 1
fi
command -v tmux >/dev/null || { printf 'tmux is required.\n' >&2; exit 1; }

session=550
repo_root=/mnt/md0/repos/homeric-freedom

attach() {
    if $detached; then
        printf 'Session %s is ready. Attach with: tmux attach -t =%s\n' "$session" "$session"
    elif [[ -n ${TMUX:-} ]]; then
        exec tmux switch-client -t "=$session"
    else
        exec tmux attach-session -t "=$session"
    fi
}

if tmux has-session -t "=$session" 2>/dev/null; then
    attach
    exit 0
fi

# Check everything before creating windows, so a missing installation is clear.
for directory in "$repo_root" "$repo_root/ceilo"; do
    [[ -d $directory ]] || { printf 'Missing directory: %s\n' "$directory" >&2; exit 1; }
done
for program in claude codex ssh kitty; do
    command -v "$program" >/dev/null || { printf 'Missing command: %s\n' "$program" >&2; exit 1; }
done
if ! $detached && [[ -z ${TMUX:-} ]] && [[ ! -t 0 ]]; then
    printf 'Run from a terminal, or use --detached.\n' >&2
    exit 1
fi

# Remote views wait for Enter; Enter (re)connects and Ctrl-D closes the view.
# shellcheck disable=SC2016 # expands in the view's own shell
wait_loop='while printf "Press Enter to connect: %s\n" "$0"; read -r; do "$@"; done'

# Nested tmux would swallow hbot's keys, so it gets its own tab in the kitty
# window running this script.
remote_tab() {
    local title=$1; shift
    kitty @ launch --type=tab --tab-title "$title" --keep-focus bash -c "$wait_loop" "$title" "$@" >/dev/null
}
if [[ -n ${KITTY_WINDOW_ID:-} && -z ${TMUX:-} ]]; then
    remote_tab 'hbot' ssh -t hbot tmux attach -t ceilo
    kitty @ set-tab-title '550 Main'
else
    printf 'Not run directly in kitty; skipping the hbot tab.\n' >&2
fi

# Use IDs for all targets: display names can contain spaces and tmux's colon.
setup_window() {
    local window=$1 pane=$2 command=$3 run=$4
    tmux set-option -w -t "$window" automatic-rename off
    tmux set-option -w -t "$window" allow-rename off
    if [[ -n $command ]]; then
        tmux send-keys -t "$pane" -l -- "$command"
        if [[ $run == yes ]]; then
            tmux send-keys -t "$pane" Enter
        fi
    fi
}

new_window() {
    local title=$1 directory=$2 command=$3 run=$4 ids window pane
    ids=$(tmux new-window -d -t "$session_id:" -n "$title" -c "$directory" -P -F '#{window_id} #{pane_id}')
    read -r window pane <<< "$ids"
    setup_window "$window" "$pane" "$command" "$run"
}

ids=$(tmux new-session -d -s "$session" -n 'Agent-Issue' -c "$HOME" -P -F '#{session_id} #{window_id} #{pane_id}')
read -r session_id first_window pane <<< "$ids"
tmux set-option -t "$session_id" destroy-unattached off
setup_window "$first_window" "$pane" "claude 'continue 550-ceilo-agent-vm-impl'" yes
# Agent VM is only watched, so nesting its tmux in a pane costs nothing. Watch
# the newest run or rebase: a batch's progress session and failed runs linger.
# shellcheck disable=SC2016 # expands on the VM, not here
agent_vm_watch='s=$(tmux ls -F "#{session_created} #{session_name}" 2>/dev/null | grep -E " (run|rebase)-" | sort -n | tail -n 1 | cut -d " " -f 2); if [ -n "$s" ]; then exec tmux attach -t "=$s"; else echo "No agent run on the VM."; fi'
tmux split-window -d -h -t "$pane" -c "$HOME" bash -c "$wait_loop" 'Agent VM' ssh -t ceilo "$agent_vm_watch"

new_window 'Codex' "$repo_root" 'codex' yes
new_window 'Claude' "$repo_root" 'claude' yes
new_window 'Pr-Rev: ceilo' "$repo_root/ceilo" 'claude' yes
new_window '550 Shell' "$HOME" '' no

tmux select-window -t "$first_window"
attach
