#!/usr/bin/env bash
# The everyday 550 entrypoint: one Herdr window showing 550 and hbot.
# Herdr restores its workspaces and reopens each agent's last conversation
# itself. This script only makes sure hbot's Herdr runs under its memory cap
# and brings back the two view panes, which Herdr restores as empty shells.
set -u

detached=false
case "${1:-}" in
    '') ;;
    --detached) detached=true ;;
    -h|--help)
        printf 'Usage: 550-session [--detached]\nOpen Herdr on 550 (with hbot) and reattach the Agent VM and stack views.\n'
        exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
esac
if [[ $(hostname -s) != 550 ]]; then
    printf 'This launcher is for host 550 only.\n' >&2
    exit 1
fi

herdr=$HOME/.local/bin/herdr

# hbot's server must come from its capped service. If it were missing, the
# saved-machine connection would start an uncapped one instead.
timeout 20 ssh -o BatchMode=yes hbot systemctl --user start herdr-hbot.service ||
    printf 'hbot: could not ensure its Herdr service; hbot may be offline.\n' >&2

# Run $3 in the pane labelled $2 (on machine $1; empty means 550), but only
# while that pane is sitting at an idle shell prompt.
reattach() {
    local target=() pane info
    [[ -n $1 ]] && target=(--machine "$1")
    pane=$(timeout 20 "$herdr" "${target[@]}" pane list 2>/dev/null |
        jq -r --arg l "$2" '.result.panes[] | select(.label == $l) | .pane_id' | head -n 1)
    if [[ -z $pane ]]; then
        printf '%s: no pane labelled %s to reattach.\n' "${1:-550}" "$2" >&2
        return
    fi
    info=$(timeout 20 "$herdr" "${target[@]}" pane process-info --pane "$pane" 2>/dev/null) || return
    jq -e '.result.process_info
        | .foreground_process_group_id == .shell_pid and (.foreground_processes | length) == 1' \
        <<<"$info" >/dev/null || return 0
    timeout 20 "$herdr" "${target[@]}" pane run "$pane" "$3" >/dev/null
}

reattach_views() {
    # Agents only resume once a client is attached, so wait for the server.
    for _ in $(seq 30); do
        "$herdr" status server 2>/dev/null | grep -q '^status: running' && break
        sleep 1
    done
    reattach '' agent-vm 550-agent-vm-view
    # Attach only: starting the stack's tmux from inside Herdr would put the
    # trading stack under the agents' cap and tie it to Herdr's lifetime.
    reattach hbot stack \
        'tmux attach -t =ceilo || echo "No ceilo tmux session. Start it with hbot-session from a plain SSH terminal, not from Herdr."'
}

if $detached || [[ -n ${HERDR_PANE_ID:-} ]]; then
    "$herdr" status server 2>/dev/null | grep -q '^status: running' ||
        { printf 'The local Herdr server is not running; run 550-session from Kitty.\n' >&2; exit 1; }
    reattach_views
    exit 0
fi
reattach_views >/dev/null 2>&1 &
exec "$herdr"
